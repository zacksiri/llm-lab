# Absolute path to the Hugging Face checkpoint directory on the Docker host.
MODEL_DIR=/absolute/path/to/Inkling-2-Mini
GPU_DEVICE_0=0
GPU_DEVICE_1=1
HOST_PORT=6002
MAX_MODEL_LEN=200000
GPU_MEMORY_UTILIZATION=0.93
PREFILL_CHUNK=2048
# Opt in to the wider SM86 full-attention INT8 prefill tile.
INKLING_SM86_INT8_PREFILL=0
