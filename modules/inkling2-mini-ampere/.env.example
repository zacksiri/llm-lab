# Absolute path to the Hugging Face checkpoint directory on the Docker host.
MODEL_DIR=/absolute/path/to/Inkling-2-Mini
GPU_DEVICE_0=0
GPU_DEVICE_1=1
HOST_PORT=6002
MAX_MODEL_LEN=200000
GPU_MEMORY_UTILIZATION=0.93
PREFILL_CHUNK=2048
# Opt in to the wider SM86 full-attention INT8 prefill tile.
INKLING_SM86_INT8_PREFILL=0
# Ready-to-use tuned profile lives in profiles/sm86-tuned.example. The commented
# single-file opt-in below keeps the original defaults intact; see benchmarks/SM86_AB.md.
# ASYNC_FLAG=--async-scheduling
# PREFILL_CHUNK=1024
# INKLING_SM86_INT8_VERIFY_SPLITS=48
# INKLING_SM86_INT8_VERIFY_TILE=1
# DSPARK_K=3
# DECODE_GRAPH_TOKENS=8  # 2 requests x (1 + DSPARK_K)
